{
	"extends": "@thundercraft5/tsconfig/node22.tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"module": "ESNext",
		"target": "ESNext",
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"lib": [
			"ESNext",
			"ES2021.WeakRef"
		],
		"composite": true,
		"moduleResolution": "bundler",
		"declarationDir": "dist/types",
		"emitDecoratorMetadata": false,
		"noEmitOnError": false
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules/.pnpm/@types*",
		"node_modules",
		"dist"
	]
}